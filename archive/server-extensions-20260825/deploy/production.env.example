# Copy to deploy/production.env and replace every value before deployment.
POSTGRES_USER=requirement_platform
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://requirement_platform:replace-with-a-long-random-password@postgres:5432/requirement_platform?schema=public
REQUIREMENT_PLATFORM_STORE=postgres

# Verify both image tags against the official release notes before first deployment.
OUTLINE_IMAGE=docker.getoutline.com/outlinewiki/outline:1.7.1
MINIO_IMAGE=replace-with-an-approved-pinned-minio-image

MINIO_ROOT_USER=replace-with-minio-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-app-access-key
S3_SECRET_ACCESS_KEY=replace-with-app-secret-key
S3_BUCKET=requirement-demo

APP_BASE_URL=https://req.example.com
MCP_API_TOKEN=replace-with-a-long-random-token
AUTH_MODE=feishu
AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret-at-least-32-characters
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_ALLOWED_TENANT_KEYS=replace-with-your-tenant-key

# Any OpenAI-compatible Chat Completions service. Keep the secret in this file only.
AI_API_BASE_URL=https://ai.example.com/v1
AI_API_KEY=replace-with-ai-api-key
AI_MODEL=replace-with-approved-model

OUTLINE_BASE_URL=https://outline.internal.example.com
OUTLINE_API_KEY=replace-with-outline-api-key
