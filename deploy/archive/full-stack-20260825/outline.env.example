# Copy to deploy/outline.env. Do not commit real values.
NODE_ENV=production
URL=https://outline.internal.example.com
PORT=3000
SECRET_KEY=replace-with-a-64-character-random-secret
UTILS_SECRET=replace-with-a-second-64-character-random-secret
DATABASE_URL=postgres://requirement_platform:replace-with-a-long-random-password@postgres:5432/outline
REDIS_URL=redis://redis:6379

FILE_STORAGE=s3
AWS_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_UPLOAD_BUCKET_NAME=outline
AWS_S3_UPLOAD_BUCKET_URL=http://minio:9000/outline
AWS_ACCESS_KEY_ID=replace-with-outline-storage-key
AWS_SECRET_ACCESS_KEY=replace-with-outline-storage-secret
AWS_S3_UPLOAD_MAX_SIZE=26214400

# Outline is internal-only. Configure a real OIDC provider before exposing it.
OIDC_ISSUER_URL=https://idp.example.com
OIDC_CLIENT_ID=replace-with-outline-oidc-client-id
OIDC_CLIENT_SECRET=replace-with-outline-oidc-client-secret
OIDC_SCOPES=openid profile email
OAUTH_DISABLE_DCR=true
