# Host-side settings. Keep the completed file out of Git.
REQUIREMENT_PLATFORM_DOCKER_PROJECT_DIR=/opt/requirement-platform
REQUIREMENT_PLATFORM_DOCKER_COMPOSE_FILE=/opt/requirement-platform/docker-compose.yml
REQUIREMENT_PLATFORM_DOCKER_DATA_DIR=/opt/requirement-platform/data
REQUIREMENT_PLATFORM_DOCKER_UPDATE_REQUEST_FILE=/opt/requirement-platform/data/requirement-platform/update-request
REQUIREMENT_PLATFORM_DOCKER_UPDATE_STATUS_FILE=/opt/requirement-platform/data/requirement-platform/update-status.json
REQUIREMENT_PLATFORM_DOCKER_UPDATE_LOG_FILE=/opt/requirement-platform/docker-update.log
REQUIREMENT_PLATFORM_CONTAINER_NAME=requirement-platform
REQUIREMENT_PLATFORM_DOCKER_IMAGE=ghcr.io/zhougepeng/requirement-platform
REQUIREMENT_PLATFORM_DOCKER_UPDATE_POLL_SECONDS=2
REQUIREMENT_PLATFORM_DOCKER_HEALTH_TIMEOUT_SECONDS=180
