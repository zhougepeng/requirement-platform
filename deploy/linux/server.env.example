# This file is created only when no server .env.local exists. Do not commit the completed file.
AUTH_MODE=feishu
APP_BASE_URL=https://your-domain.example.com
# 临时使用 http://公网IP:3000 跑通飞书扫码时，改为该 IP 地址，并显式填写同样的回调地址：
# FEISHU_REDIRECT_URI=http://47.85.37.105:3000/auth/callback
# AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECRET=replace-with-a-random-string-at-least-32-characters-long
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace-with-your-feishu-app-secret
FEISHU_ALLOWED_TENANT_KEY=replace-with-your-tenant-key
# 不知道 tenant_key 时，临时设置 true 并扫码读取；复制后删除此项再重启。
# FEISHU_TENANT_DISCOVERY=true
# 首次扫码默认普通成员；如需首位管理员，请填写其飞书 open_id。
# FEISHU_ADMIN_OPEN_IDS=ou_admin_1
# FEISHU_PUBLISHER_OPEN_IDS=ou_product_manager_1
MCP_API_TOKEN=replace-with-a-separate-long-random-token
REQUIREMENT_PLATFORM_DATA_DIR=/opt/requirement-platform/data
REQUIREMENT_PLATFORM_PUBLISHED_DEMO_DIR=/opt/requirement-platform/data/published-demos
# 仅保存在本机的每日备份；建议另行同步到对象存储或其他主机。
REQUIREMENT_PLATFORM_BACKUP_DIR=/opt/requirement-platform/backups
REQUIREMENT_PLATFORM_BACKUP_RETENTION_DAYS=14
