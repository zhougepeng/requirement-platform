[Unit]
Description=Requirement Platform
After=network.target

[Service]
Type=simple
User=requirement-platform
WorkingDirectory=__PLATFORM_ROOT__/current
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=__PLATFORM_ROOT__/.env.local
ExecStart=/usr/bin/env node __PLATFORM_ROOT__/current/.next/standalone/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
